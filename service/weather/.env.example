DB_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=fishfind;encrypt=true;trustServerCertificate=false
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Weather.gov requires a User-Agent. Include a reachable site or email.
# WEATHER_GOV_USER_AGENT=efj-backend-weather/1.0 (ops@example.com)

# Optional: load dotenv from a custom location.
# DOTENV_PATH=/app/.env

# Optional: weekly report email (Friday 08:00 by default). If SMTP_HOST or
# REPORT_EMAIL_TO is left unset, the report is silently skipped -- the weather
# worker itself is unaffected either way.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# REPORT_EMAIL_TO=ops@example.com
# REPORT_EMAIL_FROM=weather-service@example.com

# Optional JVM flags
# JAVA_OPTS=-Xms256m -Xmx512m
