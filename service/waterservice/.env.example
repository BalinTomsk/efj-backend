DB_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_username
DB_PASSWORD=your_password

# USGS Water Data API key (https://api.waterdata.usgs.gov/signup), sent as X-Api-Key. Optional, but the
# anonymous rate limit is far below what an hourly US snapshot from two services needs.
USGS_API_KEY=your_usgs_api_key

# Optional: if you want dotenv-java to read a file inside the container instead of standard env vars.
# DOTENV_PATH=/app/.env

# Optional JVM flags
# JAVA_OPTS=-Xms256m -Xmx512m

# Status heartbeat period in seconds (service status page). Default and MINIMUM 60: lower values are raised to 60, so a
# service never reports more often than once a minute. Larger values cut RabbitMQ traffic further; then also raise
# ServiceStatusDeadAfterSeconds (frontend Web.config, default 180) to at least 3x this, or healthy services read as dead.
# STATUS_INTERVAL_SECONDS=60
