			<column name="tmHigh" type="float" />
			<column name="maxWin" type="float" />
			<column name="shortText" type="varchar" />
			<column name="longText" type="varchar" />
			<column name="icon" type="varchar" />
			<column name="sid" type="int" />
		</view>
		<view name="vGetLake" >
			<view_script><![CDATA[CREATE VIEW dbo.vGetLake 
WITH SCHEMABINDING 
AS
