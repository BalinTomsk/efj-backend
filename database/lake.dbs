		<view name="vget_fish_list" >
			<view_script><![CDATA[
CREATE VIEW dbo.vget_fish_list
WITH SCHEMABINDING
AS 
  SELECT  fish_Id, fish_name  FROM dbo.FISH 
     WHERE ( fish_Type & 1 ) = 1                   --- sport species
]]></view_script>
