		<function name="fn_getfirstmlifish" id="Function_3886798" isSystem="false" >
			<string><![CDATA[
-- get fish for station science view related or any first
--     SELECT dbo.fn_getfirstmlifish('02AB014');
CREATE function dbo.fn_getfirstmlifish(@mli varchar(64))
returns uniqueidentifier
WITH SCHEMABINDING
as
begin
    DECLARE @result uniqueidentifier;
      WITH cte AS
      ( 
            SELECT TOP 1 fish_id, w.mli FROM dbo.lake_fish fl JOIN dbo.lake l ON l.lake_id = fl.lake_id JOIN dbo.WaterStation w ON w.lakeid = l.lake_id 
      )
      SELECT TOP 1 @result = fish_id FROM
      (
            SELECT TOP 1 fish_id FROM cte WHERE mli = @mli
            UNION ALL
            SELECT TOP 1 fish_id FROM cte 
      )x
      RETURN @result;
END
]]></string>
		</function>
