   , source_name + '[' + source_country + '-' + source_state + ']' as source_Lake
   , mouth_name  + '[' + mouth_country  + '-' + mouth_state  + ']' as mouth_Lake
   , source_id, mouth_id, [source_Elevation], [mouth_Elevation], [source_Lat], [source_Lon]
   , [mouth_Lat], [mouth_Lon], [link], length, depth, area
   , pic, [phosphorus]  
   FROM dbo.vw_lake
]]></view_script>
