			<column name="fish_image_author" type="nvarchar" />
			<column name="fish_image_link" type="nvarchar" />
			<column name="fish_image_label" type="nvarchar" />
			<column name="fish_image_tag" type="nvarchar" />
			<column name="fish_image_stamp" type="datetime2" />
