    , tmLow, tmHigh, maxWin, shortText, longText, icon, w.sid as sid
      FROM dbo.weather_Forecast f 
        JOIN dbo.WaterStation w on f.link=w.id WHERE tm IS NULL AND dt >= CONVERT(VARCHAR(10),GETDATE(),101)   
]]></view_script>
			<column name="dt" type="date" />
			<column name="degree" type="float" />
			<column name="gpfDay" type="float" />
			<column name="gpfNight" type="float" />
			<column name="humidity" type="float" />
