		<view name="vw_fish_spot" >
			<view_script><![CDATA[
CREATE VIEW dbo.vw_fish_spot
WITH SCHEMABINDING
AS
     select  spot_lat, spot_lon, b.spot_sid 
        from dbo.Spot a LEFT JOIN dbo.fish_spot b ON a.spot_id = b.spot_id
]]></view_script>
			<column name="spot_lat" type="float" />
			<column name="spot_lon" type="float" />
			<column name="spot_sid" type="int" />
		</view>
		<view name="vw_lake" >
			<view_script><![CDATA[---- SELECT * FROM dbo.vw_lake WHERE lake_id = '0E7A1C5B-76BA-4CD2-84C9-5E448EF19F0C'
---- SELECT * FROM dbo.fn_get_lake_list( 'ON', 'CA', 1, 'A' ) ORDER BY lake_name ASC
---- SELECT * FROM dbo.vw_lake WHERE lake_name = N'Lake of the Prairies'
CREATE VIEW dbo.vw_lake
WITH SCHEMABINDING
AS 
    SELECT ROW_NUMBER() OVER (ORDER BY l.lake_name ASC) AS num 
        , l.lake_id, l.lake_name, l.alt_name, l.old_id, l.length, l.depth, l.width, l.area, l.phosphorus, l.locType
        , l.stamp, l.basin, l.watershield, l.link, l.PH, l.locked, l.editor, l.pic, l.descript, l.Volume, l.Shoreline, l.Drainage, l.surface
        , l.Discharge, s.location, l.isfish, l.fishing
	    , l.source AS source_id, source.lake_name AS source_name, s.Elevation AS source_Elevation, s.lat AS source_Lat, s.lon AS source_Lon
        , s.state AS source_state, s.country AS source_country, s.county as source_county, s.city as source_city, s.district as source_district, s.zone as source_zone
	    , l.mouth AS mouth_id, mouth.lake_name AS mouth_name, m.Elevation AS mouth_Elevation, m.Lat AS mouth_Lat, m.Lon AS mouth_Lon
        , m.state AS mouth_state, m.country AS mouth_country, m.county AS mouth_county, m.city AS mouth_city, m.district AS mouth_district, m.zone AS mouth_zone
        , ABS(s.Lat-m.Lat) / 2.0 + (CASE WHEN s.Lat < m.Lat THEN s.Lat ELSE m.Lat END) AS lat
        , ABS(s.Lon-m.Lon) / 2.0 + (CASE WHEN s.Lon < m.Lon THEN s.Lon ELSE m.Lon END) AS lon
        , COALESCE(RTRIM(s.city),    RTRIM(m.city))    AS city
        , COALESCE(RTRIM(s.county),  RTRIM(m.county))  AS county
        , COALESCE(RTRIM(s.state),   RTRIM(m.state))   AS state
        , COALESCE(RTRIM(s.country), RTRIM(m.country)) AS country
	    FROM dbo.lake l  
            LEFT JOIN dbo.lake mouth  ON mouth.lake_id  = l.mouth
            LEFT JOIN dbo.lake source ON source.lake_id = l.source

            JOIN dbo.Tributaries m ON m.main_lake_id = l.lake_id AND m.side = 32
            JOIN dbo.Tributaries s ON s.main_lake_id = l.lake_id AND s.side = 16
]]></view_script>
			<column name="num" type="bigint" />
			<column name="lake_id" type="uniqueidentifier" />
			<column name="lake_name" type="nvarchar" />
			<column name="alt_name" type="nvarchar(max)" />
			<column name="old_id" type="varchar" />
			<column name="length" type="int" />
			<column name="depth" type="int" />
			<column name="width" type="int" />
			<column name="area" type="int" />
			<column name="phosphorus" type="float" />
			<column name="locType" type="int" />
			<column name="stamp" type="datetime2" />
			<column name="basin" type="varchar" />
			<column name="watershield" type="nvarchar" />
			<column name="link" type="nvarchar(max)" />
			<column name="PH" type="float" />
			<column name="locked" type="bit" />
			<column name="editor" type="uniqueidentifier" />
			<column name="pic" type="image" />
			<column name="descript" type="nvarchar(max)" />
			<column name="Volume" type="float" />
			<column name="Shoreline" type="int" />
			<column name="Drainage" type="nvarchar" />
			<column name="surface" type="int" />
			<column name="Discharge" type="nvarchar" />
			<column name="location" type="nvarchar(max)" />
			<column name="isfish" type="bit" />
			<column name="fishing" type="nvarchar(max)" />
			<column name="source_id" type="uniqueidentifier" />
			<column name="source_name" type="nvarchar" />
			<column name="source_Elevation" type="int" />
			<column name="source_Lat" type="float" />
			<column name="source_Lon" type="float" />
			<column name="source_state" type="char" />
			<column name="source_country" type="char" />
			<column name="source_county" type="nvarchar" />
			<column name="source_city" type="nvarchar" />
