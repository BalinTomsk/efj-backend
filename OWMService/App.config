<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source = |SQL/CE|"/>
  </connectionStrings>
  <appSettings>
    <!-- Log file path for both Debug and Release modes -->
    <!-- Leave empty to use default: C:\ProgramData\OWMService\Logs (service) or AppData\Roaming (user) -->
    <!-- Or specify full path like: C:\Logs\OWMService\OWMService.log -->
    <add key="LogFilePath" value=""/>
    
    <!-- Event Log configuration -->
    <add key="EventLogSource" value="OWMService"/>
    <add key="EventLogName" value="Application"/>
  </appSettings>
</configuration>