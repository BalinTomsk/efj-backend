<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source = |SQL/CE|"/>
  </connectionStrings>
  <appSettings>
    <!-- Optional: Set custom log file path. If not set, uses AppData\OWMService\Logs\OWMService.log -->
    <add key="LogFilePath" value=""/>
    <!-- Event Log source and log name -->
    <add key="EventLogSource" value="OWMService"/>
    <add key="EventLogName" value="Application"/>
  </appSettings>
</configuration>