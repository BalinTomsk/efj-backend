############################
# Claude Code local settings (may contain machine-local allow-lists / secrets)
############################
**/.claude/settings.local.json

############################
# Claude Code project skills (local tooling, not part of the service)
############################
**/.claude/skills/

############################
# Application secrets
############################
# The whole secret/ directory is local-only (waterservice.secret, .env, master.key, ghcr.token, ...)
# — except Protect-Env.ps1, the .env encryptor, which contains no credentials and has to survive a
# fresh clone for the encrypted .env to be regeneratable.
#
# Written as `secret/*`, not `secret/`: git does not descend into an excluded *directory*, so a
# negation can never re-include a file when the directory itself is excluded. Excluding the contents
# instead leaves the negation below able to take effect.
secret/*
!secret/Protect-Env.ps1

# Keys and certificates — never commit private key material.
# Covers service/docs/ssh.key and anything similar dropped alongside the docs.
*.key
*.pem
*.p12
*.pfx
*.ppk
*.jks
*.keystore
id_rsa
id_ed25519

application.yml
# weather's application.yml holds only ${ENV_VAR} placeholders — safe to track.
# (Negation must come AFTER the "application.yml" exclude above to take effect.)
!service/weather/src/main/resources/application.yml
.env
config.ini
fisheditor.sql 
lakeeditor.sql 
OWMService/Res/OWMService.reg

database/database/mssql/ffi2.sql
database/database/mssql/UNIT_TESTS/cleaned.txt
database/database/mssql/Data/*.sql
service/docs/do-update.md
service/weather/docs/do-update.md
service/weather/docs/digitalocean.md


Skills/*
docs/*